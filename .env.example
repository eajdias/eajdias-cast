# Porta de acesso externo (ex: http://vps-ip:8095)
PORT=8095

# Senha de login web
PASSWORD=SuaSenhaForteAqui@123

# Caminhos dos diretórios no host/VPS ( Precisam Existir)
MEDIA_BIND=/mnt/homelab/media
CACHE_BIND=./data/cache

# Concorrência do ffmpeg (thumbs + remux áudio). Vazio = automático
# (metade dos núcleos, 1–8): 4 num i7 de 8 threads, 1 numa VPS de 1 vCPU
# FF_SLOTS=4

# VA-API (decode na GPU). Vazio = autodetecta /dev/dri/renderD* com probe
# real e usa se funcional, senão CPU. 0 = força CPU
# FF_VAAPI=0
